<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ferry" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorAccent">@color/course</item>
        <item name="android:colorControlActivated">@color/course</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Day chart: light water under the status bar, so dark icons. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>