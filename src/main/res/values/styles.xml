<?xml version="1.0" encoding="utf-8"?>
<!-- Harbor type roles and components. See DESIGN.md. -->
<resources>
    <!-- Empty base: "Ferry.X" names make Android look for a parent called "Ferry". -->
    <style name="Ferry" />

    <style name="Ferry.Wordmark">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.24</item>
        <item name="android:textColor">@color/signal</item>
    </style>

    <style name="Ferry.Kicker">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Ferry.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Ferry.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Ferry.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Ferry.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Ferry.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Ferry.Button.Primary">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/on_signal</item>
    </style>

    <style name="Ferry.Button.Secondary">
        <item name="android:background">@drawable/bg_secondary</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Ferry.Button.Text">
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
