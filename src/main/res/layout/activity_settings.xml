<?xml version="1.0" encoding="utf-8"?>
<!--
Settings: everything you set once, so the chart screen keeps only the link, the last crossing, Send and the logbook.
Sections: Appearance, Syncing, Pairing, Keep Ferry running, About. Same Nautical chart type and colors (see DESIGN.md).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/back"
            style="@style/Ferry.Button.Text"
            android:layout_width="wrap_content"
            android:layout_marginStart="-10dp"
            android:contentDescription="Back to the chart"
            android:text="← Back" />

        <TextView
            style="@style/Ferry.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="Settings"
            android:textSize="26sp" />

        <!-- Appearance -->
        <TextView
            style="@style/Ferry.Section"
            android:text="APPEARANCE" />

        <!-- One choice of three: a segmented control, so it does not look like the on/off switches below. -->
        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_segment"
            android:contentDescription="Theme"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/themeSystem"
                style="@style/Ferry.Segment"
                android:text="System" />

            <RadioButton
                android:id="@+id/themeLight"
                style="@style/Ferry.Segment"
                android:text="Light" />

            <RadioButton
                android:id="@+id/themeDark"
                style="@style/Ferry.Segment"
                android:text="Dark" />
        </RadioGroup>

        <TextView
            android:id="@+id/themeHint"
            style="@style/Ferry.Hint"
            android:layout_marginTop="8dp" />

        <!-- Syncing: only while paired. -->
        <LinearLayout
            android:id="@+id/syncing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Ferry.Section"
                android:text="SYNCING" />

            <!-- Standard Ferry cannot send by itself, so it shows this title and a link instead of a switch. -->
            <TextView
                android:id="@+id/autoTitle"
                style="@style/Ferry.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Send copies automatically" />

            <Switch
                android:id="@+id/autoSwitch"
                style="@style/Ferry.Switch"
                android:text="Send copies automatically" />

            <TextView
                android:id="@+id/autoBody"
                style="@style/Ferry.Hint" />

            <Button
                android:id="@+id/autoHelp"
                style="@style/Ferry.Button.Text"
                android:layout_width="wrap_content"
                android:layout_marginStart="-10dp"
                android:layout_marginTop="4dp" />

            <Switch
                android:id="@+id/imagesSwitch"
                style="@style/Ferry.Switch"
                android:text="Images" />

            <TextView
                style="@style/Ferry.Hint"
                android:text="Copied images cross both ways, up to 10 MB." />

            <Switch
                android:id="@+id/screenshotsSwitch"
                style="@style/Ferry.Switch"
                android:text="Send screenshots" />

            <TextView
                android:id="@+id/screenshotsBody"
                style="@style/Ferry.Hint" />

            <Switch
                android:id="@+id/photosSwitch"
                style="@style/Ferry.Switch"
                android:text="Let the laptop see photos" />

            <TextView
                android:id="@+id/photosBody"
                style="@style/Ferry.Hint" />
        </LinearLayout>

        <!-- Pairing: only while paired. Before that, the chart screen shows the pairing steps. -->
        <LinearLayout
            android:id="@+id/pairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Ferry.Section"
                android:text="PAIRING" />

            <TextView
                android:id="@+id/pairTitle"
                style="@style/Ferry.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/pairBody"
                style="@style/Ferry.Hint"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/unpair"
                style="@style/Ferry.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Unpair" />
        </LinearLayout>

        <!-- Keep Ferry running: only while paired. -->
        <LinearLayout
            android:id="@+id/running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Ferry.Section"
                android:text="KEEP FERRY RUNNING" />

            <TextView
                style="@style/Ferry.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Background use" />

            <TextView
                android:id="@+id/batteryBody"
                style="@style/Ferry.Hint"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/battery"
                style="@style/Ferry.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Allow background use" />

            <LinearLayout
                android:id="@+id/xiaomi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Ferry.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Autostart" />

                <TextView
                    style="@style/Ferry.Hint"
                    android:layout_marginTop="4dp"
                    android:text="Xiaomi phones stop apps that are not on the Autostart list. Open the app settings and turn on Autostart." />

                <Button
                    android:id="@+id/appSettings"
                    style="@style/Ferry.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open app settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- About -->
        <TextView
            style="@style/Ferry.Section"
            android:text="ABOUT" />

        <TextView
            android:id="@+id/version"
            style="@style/Ferry.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/updateBody"
            style="@style/Ferry.Hint"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/update"
                style="@style/Ferry.Button.Secondary"
                android:layout_width="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/help"
                style="@style/Ferry.Button.Text"
                android:layout_width="wrap_content"
                android:text="How Ferry works" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
