<?xml version="1.0" encoding="utf-8"?>
<!--
THESIS: Ferry draws your clipboard as a sea chart: two harbors and the course between them. It answers "is the link up, what crossed last" at a glance and refuses the stock list-of-settings screen.
OWN-WORLD: Nautical chart. Day: blue shallows, buff land, ink-navy harbors. Night: a soft charcoal chart with grey contours. Magenta is the course and the one action. Italic Barlow names places.
STORY: The user glances at the chart and the last crossing, trusts the link, taps Send if needed, scrolls the logbook to copy something again.
FIRST VIEWPORT: The chart (wordmark top left, status pill top right, harbors and course) runs under the status bar; under it the last crossing in large type, then the magenta Send button.
FORM: Owner-chosen "Nautical chart" from the four-direction canvas (Departure board, Nautical chart, Boarding pass, Native), with a soft charcoal night mode.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The chart, edge to edge. Its height and the top margins of the wordmark and pill grow by the status-bar inset in code. -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <app.ferry.ChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/wordmark"
                style="@style/Ferry.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:text="FERRY" />

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="62dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <View
                    android:id="@+id/lamp"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/lamp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/barlow_medium"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Settings, on a pill like the status, so it reads on the chart. 44dp touch target around a 32dp pill. -->
            <ImageButton
                android:id="@+id/settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_settings"
                android:contentDescription="Settings"
                android:scaleType="center"
                android:src="@drawable/ic_settings" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/crossing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/route"
                    style="@style/Ferry.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/preview"
                    style="@style/Ferry.Crossing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="4" />
            </LinearLayout>

            <Button
                android:id="@+id/send"
                style="@style/Ferry.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="18dp"
                android:text="Send clipboard to laptop" />

            <Button
                android:id="@+id/helm"
                style="@style/Ferry.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="Helm: use this phone as a remote" />

            <!-- Notices: at most one at a time, the most urgent (see MainActivity.render). The rest lives in Settings. -->
            <LinearLayout
                android:id="@+id/updateCard"
                style="@style/Ferry.Notice"
                android:visibility="gone">

                <TextView
                    android:id="@+id/updateTitle"
                    style="@style/Ferry.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/updateBody"
                    style="@style/Ferry.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/update"
                    style="@style/Ferry.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/autoCard"
                style="@style/Ferry.Notice"
                android:visibility="gone">

                <!-- Ferry Auto only, while automatic sending is off. -->
                <TextView
                    style="@style/Ferry.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send copies automatically" />

                <TextView
                    style="@style/Ferry.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Skip the Send button. Ferry uses Android\'s accessibility permission to notice taps on Copy. It reads only the label of what you tap, not the rest of the screen.\n\nIf the switch is greyed out, open App info, tap the ⋮ menu, then Allow restricted settings." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/autoToggle"
                        style="@style/Ferry.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:text="Turn on" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/autoAppInfo"
                        style="@style/Ferry.Button.Text"
                        android:layout_width="wrap_content"
                        android:text="App info" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/batteryCard"
                style="@style/Ferry.Notice"
                android:visibility="gone">

                <TextView
                    style="@style/Ferry.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep the link open" />

                <TextView
                    style="@style/Ferry.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Android cuts the connection when the phone sleeps, so laptop copies stop arriving. Allow Ferry to run in the background." />

                <Button
                    android:id="@+id/battery"
                    style="@style/Ferry.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Allow background use" />
            </LinearLayout>

            <!-- The logbook: earlier crossings. Rows come from res/layout/item_crossing.xml. -->
            <LinearLayout
                android:id="@+id/historyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Ferry.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Logbook · tap to copy again, or to open a file" />

                    <Button
                        android:id="@+id/clearHistory"
                        style="@style/Ferry.Button.Text"
                        android:layout_width="wrap_content"
                        android:text="Clear" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/rule" />

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Pairing: only until paired. Afterwards it lives in Settings. -->
            <LinearLayout
                android:id="@+id/pairCard"
                style="@style/Ferry.Notice"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/pairTitle"
                    style="@style/Ferry.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/pairBody"
                    style="@style/Ferry.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/pairError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/barlow_medium"
                    android:textColor="@color/adrift"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/manualRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/topic"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:fontFamily="@font/barlow_regular"
                        android:hint="Pairing code"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions|textVisiblePassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/manualSave"
                        style="@style/Ferry.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Pair" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/scan"
                        style="@style/Ferry.Button.Primary"
                        android:layout_width="wrap_content"
                        android:text="Scan QR code" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/pairAlt"
                        style="@style/Ferry.Button.Text"
                        android:layout_width="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
