<?xml version="1.0" encoding="utf-8"?>
<!-- One logbook entry: time, course arrow, kind icon, what crossed. Tap copies it again, or opens a file. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_text_button"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/itemMeta"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_bold"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/itemArrow"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_medium"
        android:textColor="@color/course"
        android:textSize="16sp" />

    <!-- What crossed: text, link, image or file (ic_kind_*). -->
    <ImageView
        android:id="@+id/itemKind"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:tint="@color/ink_muted" />

    <TextView
        android:id="@+id/itemText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/barlow_regular"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="15sp" />
</LinearLayout>
