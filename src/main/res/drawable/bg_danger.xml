<?xml version="1.0" encoding="utf-8"?>
<!-- A button that undoes something (Unpair): outlined in the adrift color, so it does not look like a plain action. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/adrift" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
