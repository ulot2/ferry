<?xml version="1.0" encoding="utf-8"?>
<!-- The settings button: a 32dp round pill in the middle of a 44dp touch target, with a ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/pill" />
        </shape>
    </item>
</ripple>
