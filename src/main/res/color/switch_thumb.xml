<!-- Switch knob: course when on, the chip-off grey when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/rule" android:state_enabled="false" />
    <item android:color="@color/course" android:state_checked="true" />
    <item android:color="@color/ground" />
</selector>
