<?xml version="1.0" encoding="utf-8"?>
<!-- Taps, "Copied" toasts and window changes only; no access to screen content. See AutoSendService. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeNotificationStateChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/auto_send_description"
    android:notificationTimeout="100" />
