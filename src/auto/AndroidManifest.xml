<?xml version="1.0" encoding="utf-8"?>
<!-- Ferry Auto only. Play Protect blocks apps with an accessibility service when they are installed
     from a browser, so this service lives in its own edition, installed from a computer. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".AutoSendService"
            android:exported="true"
            android:label="@string/auto_send_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_send" />
        </service>
    </application>
</manifest>
