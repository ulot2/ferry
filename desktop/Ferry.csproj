<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Ferry</AssemblyName>
    <RootNamespace>Ferry</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The file's own icon: Windows uses it in the taskbar, Start menu and notification pop-ups. -->
    <ApplicationIcon>ferry.ico</ApplicationIcon>
    <!-- One Ferry.exe that runs on any 64-bit Windows 10/11 PC, with no .NET install needed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.0.0-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Barlow (SIL OFL), shared with the phone app. Loaded by Chart.cs. -->
    <EmbeddedResource Include="..\src\main\res\font\*.ttf" LogicalName="fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
